import getpass
import hashlib
import json
import os
import sys
import time
from datetime import datetime

from watchdog.events import FileSystemEventHandler
from watchdog.observers import Observer

LOG_FILE = "logs/usb_events.log"
LARGE_TRANSFER_FILES = 10      # alert if this many files are copied...
WINDOW_SECONDS = 60            # ...within this many seconds


def log_event(event, **details):
    """Save one event, with the current time, as a line in the log file."""
    record = {"time": datetime.now().strftime("%Y-%m-%d %H:%M:%S"), "event": event}
    record.update(details)
    os.makedirs("logs", exist_ok=True)
    with open(LOG_FILE, "a") as f:
        f.write(json.dumps(record) + "\n")


def sha256_of(path):
    """Calculate the SHA-256 fingerprint of a file's contents."""
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


class USBFileAuditor(FileSystemEventHandler):
    """Reacts to every file event inside the watched USB folder."""

    def __init__(self, usb_path):
        self.usb_path = usb_path
        self.user = getpass.getuser()
        self.recent_writes = []          # times of recent file writes
        self.files_written = 0
        self.bytes_written = 0
        self.alerted = False

    def name(self, path):
        """Show paths relative to the USB drive, e.g. audit_test/a.txt"""
        return os.path.relpath(path, self.usb_path)

    def ignored(self, path):
        return "System Volume Information" in path or ".Trash" in path

    def on_created(self, event):
        if event.is_directory or self.ignored(event.src_path):
            return
        print("FILE CREATED :", self.name(event.src_path))
        log_event("FILE_CREATED", file=self.name(event.src_path), user=self.user)

    def on_closed(self, event):
        """Called when a file has been completely written."""
        if event.is_directory or self.ignored(event.src_path):
            return
        try:
            size = os.path.getsize(event.src_path)
            digest = sha256_of(event.src_path)
        except OSError:
            return
        self.files_written += 1
        self.bytes_written += size
        print(f"FILE WRITTEN : {self.name(event.src_path)}  ({size} bytes)  sha256={digest[:16]}...")
        log_event("FILE_WRITTEN", file=self.name(event.src_path), size=size,
                  sha256=digest, user=self.user)
        self.check_large_transfer()

    def on_deleted(self, event):
        if self.ignored(event.src_path):
            return
        print("FILE DELETED :", self.name(event.src_path))
        log_event("FILE_DELETED", file=self.name(event.src_path), user=self.user)

    def on_moved(self, event):
        if self.ignored(event.dest_path):
            return
        old, new = self.name(event.src_path), self.name(event.dest_path)
        print("FILE RENAMED :", old, "->", new)
        log_event("FILE_MOVED", old_file=old, file=new, user=self.user)

    def check_large_transfer(self):
        """Warn if many files are written to the USB drive in a short time."""
        now = time.time()
        self.recent_writes.append(now)
        self.recent_writes = [t for t in self.recent_writes if now - t <= WINDOW_SECONDS]
        if len(self.recent_writes) >= LARGE_TRANSFER_FILES and not self.alerted:
            self.alerted = True
            msg = (f"{len(self.recent_writes)} files copied to USB in under "
                   f"{WINDOW_SECONDS}s by '{self.user}' - possible data theft!")
            print("\n*** ALERT: LARGE TRANSFER -", msg, "***\n")
            log_event("LARGE_TRANSFER", message=msg, files=len(self.recent_writes),
                      user=self.user)


usb_path = sys.argv[1] if len(sys.argv) > 1 else "/mnt/usb"
if not os.path.isdir(usb_path):
    sys.exit(f"{usb_path} does not exist - is the USB drive mounted?")

auditor = USBFileAuditor(usb_path)
observer = Observer()
observer.schedule(auditor, usb_path, recursive=True)
observer.start()

print(f"Auditing file activity on {usb_path} (user: {auditor.user}) - press Ctrl+C to stop")
log_event("AUDIT_STARTED", path=usb_path, user=auditor.user)

try:
    while True:
        time.sleep(1)
except KeyboardInterrupt:
    observer.stop()
    observer.join()
    summary = (f"{auditor.files_written} files written to USB "
               f"({auditor.bytes_written} bytes) by '{auditor.user}'")
    print("\nSUMMARY:", summary)
    log_event("TRANSFER_SUMMARY", message=summary, files=auditor.files_written,
              bytes=auditor.bytes_written, user=auditor.user)

